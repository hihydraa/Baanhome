# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Optional. When set, น้องโฮม uses DeepSeek (takes priority over Gemini)
# and may answer within the Baanhome role scope even when the knowledge base has no match.
# Keep server-only; never commit the real key.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# Optional: 64 hex characters from crypto.randomBytes(32). Keep server-only and stable.
# Without this value, new analytics writes are disabled; existing search works as before.
NONG_HOME_ANALYTICS_SECRET=
